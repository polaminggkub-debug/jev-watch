{
  "name": "jev-watch",
  "version": "0.2.2",
  "description": "Watchdog for AI coding agents: stop Codex or OpenCode when they loop, stall or drift off task, then resume the same session with a correction. Built for Claude Code orchestrators. Uses Jev via OpenRouter.",
  "keywords": [
    "ai-agents",
    "coding-agent",
    "watchdog",
    "agent-monitoring",
    "codex",
    "codex-cli",
    "opencode",
    "claude-code",
    "orchestrator",
    "multi-agent",
    "llm",
    "jev",
    "typesafe",
    "openrouter",
    "loop-detection",
    "cli"
  ],
  "homepage": "https://github.com/polaminggkub-debug/jev-watch#readme",
  "bugs": {
    "url": "https://github.com/polaminggkub-debug/jev-watch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polaminggkub-debug/jev-watch.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-watch": "bin/jev-watch.js"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint bin/jev-watch.js src scripts test hooks eslint.config.js",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run check:arch && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
